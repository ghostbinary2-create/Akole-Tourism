PORT=5000
# Cloud MySQL database connection string (e.g. from Aiven, TiDB Cloud, Railway, or Clever Cloud)
DATABASE_URL="mysql://user:password@host:3306/database_name?sslaccept=strict"

# Secret key for signing JWT tokens
JWT_SECRET=your_production_jwt_secret_key_random_string_here

# The URL of your deployed frontend on Vercel
CLIENT_URL=https://akole-tourism-38n3.vercel.app

# Email (Gmail SMTP) Configuration (Optional - for welcome & broadcast emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
EMAIL_FROM="Akole Tourism <your_email@gmail.com>"
